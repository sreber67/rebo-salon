{
  "name": "rebo-v2",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:emulator",
    "test:ui": "playwright test --ui",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:fix": "npm audit fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:emulator": "npx --yes firebase-tools@15 emulators:exec --only firestore,auth --project demo-rebo-test \"vitest run tests/rules tests/api\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.1",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "twilio": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
