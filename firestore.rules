rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    match /users/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      // Self-registration lands as a plain user with no points and no salon notes -
      // role, loyalty points and stylist notes are only ever set by the salon or the server.
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.get('haircutCount', 0) == 0
        && !request.resource.data.keys().hasAny(['stylistNotes', 'stylistNotesUpdatedAt'])
      );
      // Owners may edit their own profile (name, phone, ...), but never their role,
      // their loyalty points (booking rewards are handled server-side) or the salon's notes.
      allow update: if isAdmin() || (
        isOwner(userId)
        && !changedKeys().hasAny(['role', 'haircutCount', 'stylistNotes', 'stylistNotesUpdatedAt', 'id'])
      );
      allow delete: if isOwnerOrAdmin(userId);
    }

    match /appointments/{apptId} {
      allow read: if isOwnerOrAdmin(resource.data.userId);
      // Customer bookings go through /api/appointments, which checks the stylist's
      // working hours and existing bookings before writing with the Admin SDK.
      allow create: if isAdmin();
      // Owners may only attach a reference image uploaded to the salon's Cloudinary.
      // Answering a proposed time goes through /api/appointments/[id].
      allow update: if isAdmin() || (
        isOwner(resource.data.userId)
        && changedKeys().hasOnly(['referenceImage'])
        && isShortString(request.resource.data.referenceImage, 500)
        && request.resource.data.referenceImage.matches('https://res[.]cloudinary[.]com/.*')
      );
      // Owners delete their own appointments as part of full account erasure
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /stylists/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /alerts/{alertId} {
      // userId 'admin' is the shared inbox for the salon (e.g. new booking requests):
      // any signed-in customer may drop an unread alert there, only admins can read it.
      allow read: if isOwner(resource.data.userId) || (resource.data.userId == 'admin' && isAdmin());
      allow create: if isAdmin() || (
        isSignedIn()
        && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'admin')
        && request.resource.data.isRead == false
        && isShortString(request.resource.data.message, 500)
      );
      // Owners may only mark their alerts read, or delete them
      allow update: if isAdmin() || (isOwner(resource.data.userId) && changedKeys().hasOnly(['isRead']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }
    match /waitlist/{itemId} {
      // Customers put themselves on the list; only the salon sees or clears it
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['userId', 'name', 'phone', 'date', 'stylist', 'createdAt'])
        && isShortString(request.resource.data.name, 100)
        && isShortString(request.resource.data.phone, 20)
        && isShortString(request.resource.data.stylist, 100)
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.createdAt is int;
      allow read, update, delete: if isAdmin();
    }
    match /translations/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
