rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      // Self-registration must land as a plain user - role can never be
      // set to 'admin' by the client, only ever granted by an existing admin.
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      // Owners may edit their own profile, but not their own `role` - that
      // field previously had no such guard, letting any signed-in user
      // write role:'admin' onto their own doc and self-promote, since every
      // isAdmin() check (and the whole client-side admin gate) trusts this
      // field. Only an admin may change someone's role.
      allow update: if isAdmin() || (
        isOwner(userId) && request.resource.data.role == resource.data.role
      );
      allow delete: if isOwnerOrAdmin(userId);
    }

    match /appointments/{apptId} {
      allow read: if isOwnerOrAdmin(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      // Owners may only: attach a reference image, or respond to a proposed
      // reschedule (accept -> confirmed, or reject -> cancelled). Anything else
      // (self-confirming a pending booking, editing notes/date/time/stylist
      // outright) requires admin.
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referenceImage']) ||
          (
            resource.data.status == 'proposed' &&
            (
              (request.resource.data.status == 'confirmed' &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'date', 'time', 'proposedDate', 'proposedTime'])) ||
              (request.resource.data.status == 'cancelled' &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            )
          )
        )
      );
      // Owners need to be able to delete their own appointments as part of
      // full account erasure (AccountDeletionModal batch-deletes them) -
      // admin-only delete made that batch fail with permission-denied.
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /alerts/{alertId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isAdmin() || isOwner(request.resource.data.userId);
    }
    match /translations/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}