# =============================================================================
# REBO SALON - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR ROTATED SECRETS
# NEVER COMMIT .env.local TO GIT
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE CLIENT CONFIG (Public - safe to expose in client bundle)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rebo-salon.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rebo-salon
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rebo-salon.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK (Server-only - NEVER expose to client)
# Generate new service account key in Firebase Console > Project Settings > Service Accounts
# Then: cat service-account.json | base64 -w 0
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json_here

# -----------------------------------------------------------------------------
# EMAIL SETTINGS (Server-only)
# Generate Gmail App Password: Google Account > Security > 2FA > App Passwords
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAIL=rick.maity07@gmail.com
EMAIL_USER=rick.maity07@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# -----------------------------------------------------------------------------
# TWILIO SMS (Server-only)
# Get from Twilio Console > Account Info
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# -----------------------------------------------------------------------------
# DEEPL API (Server-only)
# Get from DeepL Account > API Key
# Free tier keys end with :fx and use api-free.deepl.com
# -----------------------------------------------------------------------------
DEEPL_API_KEY=your_deepl_api_key_here

# -----------------------------------------------------------------------------
# INTERNAL API SECURITY (Server-only - NO NEXT_PUBLIC_ prefix)
# Generate a strong random string: openssl rand -hex 32
# Used for server-to-server API authentication
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# FIREBASE REGION (For GDPR compliance - use EU region)
# -----------------------------------------------------------------------------
FIREBASE_REGION=europe-west1